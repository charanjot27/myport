{
  "manifest_version": 3,
  "name": "PromptSense for video calls",
  "short_name": "PromptSense",
  "version": "0.1.0",
  "description": "Hide your script's reflection in your eyes and keep natural eye contact while reading, in Meet, Zoom, Teams and other web calls.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "PromptSense" },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://*.whereby.com/*", "https://app.riverside.fm/*", "https://streamyard.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://*.whereby.com/*", "https://app.riverside.fm/*", "https://streamyard.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["mediapipe/*"],
      "matches": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://*.whereby.com/*", "https://app.riverside.fm/*", "https://streamyard.com/*"]
    }
  ]
}
