# Copy to deploy/.env and fill in. Never commit the real file.

# Public URL users open (must be HTTPS in production; camera/mic need a secure context).
APP_URL=https://promptsense.example.com
WEB_PORT=8080

POSTGRES_PASSWORD=change-me

# Ed25519 key for signed liveness attestations: `pnpm --filter @promptsense/api keygen`
LIVENESS_PRIVATE_KEY=
LIVENESS_KEY_ID=prod-1

# Optional features — leave empty to disable.
DEEPGRAM_API_KEY=          # cloud speech (Pro)
STRIPE_SECRET_KEY=         # billing
STRIPE_WEBHOOK_SECRET=     # Stripe dashboard → webhooks → endpoint https://<APP_URL>/api/billing/webhook
STRIPE_PRICE_ID=           # recurring price for Pro
ADMIN_TOKEN=               # bearer token for GET /research/export (long random string)
