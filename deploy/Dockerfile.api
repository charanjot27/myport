# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY packages/core/package.json packages/core/
COPY services/api/package.json services/api/
RUN pnpm install --frozen-lockfile --prod --filter @promptsense/api...
COPY packages/core packages/core
COPY services/api services/api
ENV NODE_ENV=production PORT=8787
# tsx resolves from the working directory, so run from the API package.
WORKDIR /app/services/api
USER node
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=3s CMD node -e "fetch('http://localhost:8787/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "--import", "tsx", "src/server.ts"]
