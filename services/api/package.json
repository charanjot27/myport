{
  "name": "@promptsense/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PromptSense API: accounts, script sync, speech tokens, liveness attestations, billing and research uploads.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "keygen": "tsx src/scripts/keygen.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@promptsense/core": "workspace:*",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.4.0",
    "kysely": "^0.28.2",
    "pg": "^8.16.0",
    "tsx": "^4.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
